# EdgeOne Makers 部署时忽略的文件和目录
# 减少上传体积（避免 25MB 限制），并避免泄露本地数据与密钥

# 依赖与构建产物
node_modules
backend/node_modules
frontend/node_modules

# 本地数据（含 db.json 中的 token / API Key，绝不能上传）
backend/data
data

# 版本控制 / 编辑器 / 系统文件
.git
.github
.vscode
.idea
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
coverage

# 环境文件（密钥）
.env
.env.local
.env.development
.env.test
.env.production

# 本地 CLI 凭证
.edgeone

# 工作区元数据
.workbuddy

# 源码映射
*.map
